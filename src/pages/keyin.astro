import BaseLayout from "../site/BaseLayout.astro";
import KeyinTool from "../tools/keyin/components/KeyinTool.tsx";
import oflUrl from "../tools/keyin/text/fonts/OFL.txt?url";
---

<BaseLayout
  title="刻印"
  description="把你一年的 GitHub 贡献、LeetCode 刷题、Claude Code token、跑步距离、观影记录等每日数据，做成可以 3D 打印的模型。支持 17 个平台。"
  wide
>
  <header class="intro">
    <h1>刻印</h1>
    <p>
      把你一年的每日记录做成可以 3D
      打印的模型：一天一根柱子，高度对应当天的数值，底座正面压印平台名、你的名字和年份。支持编程、AI、运动健康、影音阅读、笔记任务、游戏等
      17 个平台，也可以用你自己的 JSON / CSV。
    </p>
  </header>

  <KeyinTool client:only="react">
    <p slot="fallback" class="loading">正在加载…</p>
  </KeyinTool>

  <section class="about">
    <h2>来源与许可</h2>
    <p>
      刻印衍生自 <a
        href="https://github.com/yihong0618/GitHubPoster"
        target="_blank"
        rel="noopener noreferrer">GitHubPoster</a
      >（yihong0618，MIT 协议）：skyline
      模型的设计和多数平台的数据读取方式都来自它。
    </p>
    <p>
      文字使用 Google 的 <a
        href="https://notofonts.github.io/"
        target="_blank"
        rel="noopener noreferrer">Noto</a
      > 字体，未经修改，许可为 <a href={oflUrl} target="_blank"
        >SIL Open Font License 1.1</a
      >。你生成的模型归你所有。
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }
  .intro h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }
  .intro p {
    margin: 0;
    max-width: 44rem;
    color: var(--muted);
  }
  .loading {
    color: var(--muted);
  }
  .about {
    margin-top: 2.5rem;
    max-width: 44rem;
    font-size: 0.92rem;
  }
  .about h2 {
    font-size: 1rem;
    margin: 1.5rem 0 0.5rem;
  }
</style>
